# ---------------------------------------------------------------------------
# Goods by Sadia — API
# Copy to `.env`. Never commit the real file.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/goods-by-sadia

# Signs admin sessions. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=7d

# Encrypts payment/API secrets stored in the settings document.
# Changing this makes previously saved credentials unreadable — set once.
SECRET_ENCRYPTION_KEY=change-me-to-another-long-random-string

# Comma separated. Must include the storefront + admin origin.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Public base URL of THIS api — payment gateways redirect back here.
# In production this must be https and publicly reachable.
PUBLIC_URL=http://localhost:4000

# Where to send customers after payment.
STOREFRONT_URL=http://localhost:5173

# Fallback Meta webhook verify token (also settable in the admin panel).
META_VERIFY_TOKEN=goods-by-sadia-verify

# Seeded owner account — change the password after first sign-in.
SEED_ADMIN_EMAIL=admin@goodsbysadia.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Sadia
