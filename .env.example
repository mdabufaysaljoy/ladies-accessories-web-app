# Copy to `.env` only if you need to override a default — for local dev
# against the proxy in vite.config.js, you don't need this file at all.

# ---------------------------------------------------------------------------
# API base URL. Leave unset for local dev — Vite's dev server proxies
# /api and /uploads to http://localhost:4000 (see vite.config.js), so every
# request just uses a relative path and works with no env file present.
#
# Set this ONLY when the frontend and backend are deployed on different
# domains (e.g. storefront on Vercel, API on Railway) — then the browser
# needs the real API origin baked in at build time:
#
# VITE_API_URL=https://api.goodsbysadia.com
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Legacy — only read by src/services/payment.js, which is the OLD mock
# SSLCommerz flow from before the real server/ backend existed. The live
# checkout now goes through the API (server/src/services/sslcommerz.js) and
# does not use this variable. Safe to ignore; kept so payment.js doesn't
# error if it's ever imported.
#
# VITE_PAYMENT_API=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Real secrets — SSLCommerz store ID/password, bKash keys, courier API keys,
# JWT secret, encryption key, SMTP credentials — are NEVER frontend env vars.
# They live only in server/.env and are set from the admin panel
# (Settings → Payments / Couriers / Integrations), encrypted at rest.
# Anything prefixed VITE_ gets bundled into the public JS bundle and is
# visible to every visitor — never put a secret there.
# ---------------------------------------------------------------------------
